# YouCam API key from https://yce.makeupar.com/api-console/en/api-keys/
# Leave empty to run in DEMO mode (sample scores, clearly labelled in the UI).
YOUCAM_API_KEY=

# Optional overrides
# YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# YOUCAM_FILE_PATH=/s2s/v2.0/file
# auto = HD when the photo's short side >= 1080 px, else SD. Or force: sd | hd
# YOUCAM_QUALITY=auto
